# ─── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite (zero config, free). For optional Postgres use:
# DATABASE_URL=postgresql://user:pass@localhost:5432/kagaz_ai
DATABASE_URL=sqlite:///kagaz_ai.db

# ─── Runtime mode ─────────────────────────────────────────────────────────────
# Set to "production" to enforce strict startup checks: SECRET_KEY must be a
# real 32+ character secret and ALLOWED_ORIGINS must not be "*".
# ENV_MODE=production

# ─── Auth (fully local — no Supabase needed) ──────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change_me_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# ─── AI Engines ───────────────────────────────────────────────────────────────
# Tier 0 (recommended): Native Gemini — free key at https://aistudio.google.com/apikey
#   First-class integration: structured output (responseSchema) + inline_data vision.
#   Takes priority over all other engines when set.
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Tier 1: Frontier models — any OpenAI-compatible API.
#   OpenAI:      https://api.openai.com/v1          (default base below)
#   OpenRouter:  https://openrouter.ai/api/v1       (100+ models incl. free ones)
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
#   Together / DeepSeek / ... — any endpoint speaking /chat/completions.
# When set, frontier models handle OCR + analysis at maximum accuracy;
# Ollama/Groq below serve as automatic fallbacks. Leave empty to run fully free/local.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o-mini

# Tier 2 (free & local): Ollama (open weights). Install from https://ollama.com then:
#   ollama pull qwen2.5vl:7b      # vision OCR of handwritten worksheets
#   ollama pull qwen2.5:3b        # fast text grading/analysis
#   ollama pull nomic-embed-text  # semantic similarity (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Tier 3 (free cloud fallback): Groq free tier. Free key: https://console.groq.com/keys
# Leave empty to run 100% offline on Ollama only.
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Timeouts — local models on CPU can be slow, be generous
AI_TIMEOUT_SECONDS=120
AI_VISION_TIMEOUT_SECONDS=300

# ─── Storage ──────────────────────────────────────────────────────────────────
# Local filesystem (free). Uploaded images are served at /uploads.
UPLOAD_DIR=uploads

# ─── R2 mirror (optional — survives ephemeral-disk hosts like Render free) ────
# Cloudflare R2: 10 GB free, zero egress, never expires/pauses.
# Dashboard → R2 → Create bucket → Manage API tokens (Object Read & Write)
# Leave empty to run purely on local disk (fine for local dev / VPS).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ─── Async queue (optional) ───────────────────────────────────────────────────
# Default pipeline uses FastAPI BackgroundTasks (no Redis needed).
USE_CELERY=false

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
